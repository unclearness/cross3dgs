+/// vector. Native checkpoint paths should prefer this function so large
+/// Android states have both bounded GPU staging and lower host-memory peaks.
+#[cfg(not(target_family = "wasm"))]
+pub async fn splat_to_ply_writer<W: std::io::Write>(
+    splats: Splats,
+    up_axis: Option<Vec3>,
+    writer: W,
+) -> Result<(), ExportError> {
+    let splats = splats.bake_min_scale();
+    let ply = read_splat_data(splats.clone()).await?;
+    serde_ply::to_writer(&ply, serialize_options(&splats, up_axis), writer)?;
+    Ok(())
